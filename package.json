{
  "name": "harness-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Display Codex and Claude Code usage limits on Elgato Stream Deck.",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "link": "streamdeck link com.dmrs07.harness-deck.sdPlugin",
    "restart": "streamdeck restart com.dmrs07.harness-deck",
    "watch": "rollup -c -w"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.0.0",
    "rollup": "^4.50.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  }
}
